# Use hoisted node_modules for full compatibility with React Native, Metro, and EAS CI/CD on Linux
node-linker=hoisted

# Hoist patterns for Metro module resolution
public-hoist-pattern[]=babel-*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=@metro/*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=react*

