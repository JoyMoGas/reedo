# Hoist babel packages to root node_modules so Metro/Babel can resolve them
# in Linux environments (EAS build servers use pnpm with strict symlinks)
public-hoist-pattern[]=babel-*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=@metro/*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-*
